# Pupa AI Studio — frontend environment
# Copy to .env.local for local dev. NEVER commit real values.
# On Vercel, set these in Project Settings → Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser — no secrets there.

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...   # pk_live_ in production
CLERK_SECRET_KEY=sk_test_...                    # sk_live_ in production (server-only)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SECRET=whsec_...                  # Clerk Dashboard → Webhooks

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # public anon key ("role":"anon")
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role SECRET (server-only API routes)
# SUPABASE_SERVICE_KEY=                         # legacy alias; same value also accepted

# --- FastAPI backend ---
NEXT_PUBLIC_API_URL=http://localhost:8001       # production: https://pupaai-backend.onrender.com (or api.<your-domain>)
